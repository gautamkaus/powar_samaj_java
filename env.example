# Java Backend Environment Variables
# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=powar_db
DB_USER=powar_user
DB_PASSWORD=powar_password

# JWT Configuration
JWT_SECRET=powarSecretKey123456789012345678901234567890
JWT_EXPIRATION=86400000

# Python API Configuration
PYTHON_API_URL=http://python-backend:5000

# Server Configuration
SERVER_PORT=8080

# Logging
LOGGING_LEVEL=INFO
